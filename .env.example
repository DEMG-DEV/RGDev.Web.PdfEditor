# ==============================================================================
# RGDev PDF Editor - Variables de Entorno para Producción (Vercel + Supabase + Stripe)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase (Base de datos y Autenticación Free Tier)
# Regístrate gratis en https://supabase.com y copia estas credenciales en Settings > API
# ------------------------------------------------------------------------------
VITE_SUPABASE_URL="https://tu-proyecto.supabase.co"
VITE_SUPABASE_ANON_KEY="tu-supabase-anon-key"

# Service Role Key (Solo para Serverless Functions en /api/stripe, NUNCA exponer al cliente)
SUPABASE_SERVICE_ROLE_KEY="tu-supabase-service-role-key"

# ------------------------------------------------------------------------------
# 2. Stripe (Pasarela de Pagos y Suscripciones)
# Regístrate en https://stripe.com y copia las claves en Developers > API keys
# ------------------------------------------------------------------------------
# Clave Secreta de Stripe (sk_test_... o sk_live_...)
STRIPE_SECRET_KEY="sk_test_tu_clave_secreta_stripe"

# Clave Secreta del Webhook de Stripe (whsec_... obtenida en Developers > Webhooks)
STRIPE_WEBHOOK_SECRET="whsec_tu_webhook_signing_secret"

# ID de Precios de Stripe (Creados en Stripe Dashboard > Products)
# Producto: RGDev PDF Editor Pro
STRIPE_PRICE_ID_MONTHLY="price_1Q..."  # Ejemplo: $4.99 / mes
STRIPE_PRICE_ID_ANNUAL="price_1Q..."   # Ejemplo: $39.99 / año

# ------------------------------------------------------------------------------
# 3. URL de la Aplicación
# ------------------------------------------------------------------------------
# En local: http://localhost:5173
# En Vercel: https://tu-dominio.vercel.app
VITE_APP_URL="http://localhost:5173"
